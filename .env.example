# Copia este archivo a .env.local y rellena los valores.
# Nunca subas .env.local a git.

# Proyecto Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# Password del panel restaurante (solo servidor — sin NEXT_PUBLIC_)
# Usuario fijo: restaurante
RESTAURANT_PASSWORD=cambia-esta-clave
